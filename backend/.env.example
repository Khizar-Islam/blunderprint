# Copy to .env and fill in. Never commit .env.
MONGODB_URI=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_ENABLED=true
AI_DAILY_CALL_BUDGET=400
# Free-tier limits from AI Studio (Gemini 3.5 Flash-Lite): requests/min, tokens/min, requests/day
GEMINI_RPM=15
GEMINI_TPM=250000
GEMINI_RPD=500
# One coach run: model calls, extra calls for the repair round, total tokens, timeouts (ms)
COACH_MAX_MODEL_CALLS=10
COACH_MAX_REPAIR_CALLS=2
COACH_MAX_TOKENS=120000
COACH_CALL_TIMEOUT_MS=60000
COACH_RUN_TIMEOUT_MS=300000
# What counts as a weakness: at least this much worse than the player's own average
# (0.15 = 15%), on at least this many games and (for rates per 100 moves) player moves
COACH_MIN_BASELINE_GAP=0.15
COACH_MIN_CANDIDATE_GAMES=5
COACH_MIN_CANDIDATE_MOVES=100
CORS_ORIGINS=
TRUST_PROXY_HOPS=
CONTACT_EMAIL=
MAX_GAMES_PER_PLAYER=200
# Frozen demo players, e.g. lichess:DrNykterstein (no re-import, no analysis claims, their
# report trace kept). Complete their data BEFORE adding them. An invalid entry stops startup.
DEMO_PLAYERS=
# Stage 6 guards. IP_HASH_SALT: the secret key of the visitor hash (HMAC of the IP; the IP itself
# is never stored or logged). Required on Render, at least 32 random characters; locally it may
# stay empty (a random one per process). Changing it resets every visitor's counters.
IP_HASH_SALT=
# Per visitor: imports that start (per hour, per Pacific day), coach reports that start (per day)
LIMIT_IMPORTS_PER_HOUR=5
LIMIT_IMPORTS_PER_DAY=15
LIMIT_REPORTS_PER_DAY=3
# Flood guard: requests per visitor per minute on /api (in memory)
LIMIT_REQUESTS_PER_MINUTE=300
# No NEW player is imported once dataSize + indexSize reaches this many MB
STORAGE_NEW_PLAYER_LIMIT_MB=120
# New players per Pacific day (all visitors), and queued imports before "busy"
NEW_PLAYERS_PER_DAY=40
IMPORT_QUEUE_MAX=10
PORT=5000
