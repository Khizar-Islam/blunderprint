{
  "name": "blunderprint-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:local": "node --env-file=.env dist/server.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "import:once": "tsx --env-file=.env scripts/importOnce.ts",
    "explain:games": "tsx --env-file=.env scripts/explainGames.ts",
    "backfill:classifications": "tsx --env-file=.env scripts/backfillClassifications.ts"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mongoose": "^9.11.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.34"
    }
  }
}
